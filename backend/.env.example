# Copy to backend/.env and fill in. Never commit the real file.

OPENAI_API_KEY=sk-...
# Any OpenAI model that supports structured outputs.
OPENAI_MODEL=gpt-4o
PORT=5000

# Path to a Firebase service-account JSON (Firebase console → Project settings → Service accounts).
# Keep the file outside the repo, or in backend/config/ (gitignored).
GOOGLE_APPLICATION_CREDENTIALS=./config/service-account.json

# Max flashcard generations per user per 15 minutes.
GENERATE_RATE_LIMIT=20
