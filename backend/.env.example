# Copy to backend/.env and fill in. Never commit the real file.

# Matches the `db` service in docker-compose.yml (start it with `docker compose up -d db`).
# Docker Compose overrides this for the app container.
DATABASE_URL=postgres://langgo:langgo@localhost:5433/langgo

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL users open in the browser. In development that's the Vite dev server.
# Docker Compose overrides this (PUBLIC_URL, default http://localhost:3001).
BETTER_AUTH_URL=http://localhost:3000

# Leave empty to run in demo mode: the app works end to end with built-in sample flashcards.
OPENAI_API_KEY=
# Any OpenAI model that supports structured outputs. gpt-4o-mini is inexpensive and plenty here.
OPENAI_MODEL=gpt-4o-mini

PORT=5000

# Set to the number of reverse proxies (load balancer, nginx, ...) in front of the app so
# rate limiting sees real client IPs. Leave at 0 when clients connect directly.
TRUST_PROXY_HOPS=0

# Max flashcard generations per user per 15 minutes.
GENERATE_RATE_LIMIT=20
