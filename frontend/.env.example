# Copy to frontend/.env.local for development (or to the repo-root .env for docker compose).
# Values come from Firebase console → Project settings → Your apps → Web app config.
# These are public client identifiers, not secrets, but they are inlined at build time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
