# Docker Compose variables for production (docker-compose.prod.yml). Copy to .env in the repo
# root on the server. App secrets (OpenAI key, auth secret) live in backend/.env instead.

# Domain pointing at the VPS (DNS A/AAAA record). Caddy gets an HTTPS certificate for it.
DOMAIN=langgo.example.com

# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=you@example.com

# Database password. Generate with: openssl rand -hex 24
# Hex keeps it safe to embed in the connection URL. Only applied when the database volume is
# first created; see docs/DEPLOYMENT.md to change it later.
POSTGRES_PASSWORD=

# Days of daily database backups to keep in ./backups.
BACKUP_KEEP_DAYS=14
